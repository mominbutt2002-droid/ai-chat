# Ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Модель Gemini (по умолчанию gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Запасные модели через запятую (при 503 / перегрузке)
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-3.8-flash-lite

# Порт backend API
PORT=3001

# true — только моки на фронте; false — ответы через /api/chat (Gemini)
VITE_USE_MOCKS=false
